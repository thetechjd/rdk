[Unit]
Description=Kaia private RDK node host (Koryo)
After=network-online.target
Wants=network-online.target
[Service]
Type=simple
User=kaia
Group=kaia
WorkingDirectory=/opt/rdk
EnvironmentFile=/etc/kaia/host.env
ExecStart=/usr/bin/node /opt/rdk/hosting/cocoa-host.mjs
Restart=on-failure
StateDirectory=kaia
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/kaia
MemoryMax=4G
TasksMax=128
UMask=0077
[Install]
WantedBy=multi-user.target
